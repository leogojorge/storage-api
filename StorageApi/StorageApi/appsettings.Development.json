{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoSettings": {
    "ConnectionString": "mongodb://localhost:27017"
  },

  "Serilog": {
    "WriteTo": [
      {
        "Name": "EventCollector",
        "Args": {
          "splunkHost": "http://localhost:8088",
          "uriPath": "services/collector",
          "eventCollectorToken": "8f598f49-0c5d-42e3-bace-5afc862020ba",
          "index": "logs_storageapi",
          "sourceType": "_json"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
